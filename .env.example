# ThyroPredict AI Configuration Environment Variables

# Backend Configuration
PROJECT_NAME="ThyroPredict AI"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-robust-production-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to persistent local SQLite at project root)
# For production PostgreSQL / MySQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/thyropredict_db"
DATABASE_URL="sqlite:///thyropredict.db"

# Model Artifacts and Data Directories (Optional overrides)
# ARTIFACTS_DIR="/app/artifacts"
# DATA_DIR="/app/data"

# Frontend Configuration (Used during Vite build/deployment)
VITE_API_URL="http://localhost:8000/api"
